# Nuxt
.nuxt
.output
.data
.nitro
.cache

# Dipendenze
node_modules

# Variabili d'ambiente (contengono password DB e segreti)
.env
.env.*
!.env.example

# Log
*.log

# Dump di database (contengono dati personali: MAI su GitHub)
*.sql
!server/database/migrations/*.sql
backup-*.json
*-backup*.json

# Script usa-e-getta di debug (mai nel repo)
*.tmp.mjs
*.tmp.ts
*.tmp.js

# OS
.DS_Store
Thumbs.db

# Documentazione, agenti e vecchi file
.old/
.agents/
.claude/
.cursor/
.superpowers/
docs/
.design/
ERROR_LOGS.md
append-docs.mjs
# Ignora file markdown nella root tranne README.md
/*.md
!/README.md
manuale/
# Strumenti locali: impostazioni del design e video di presentazione
.impeccable/
brag-output/

# App per telefono (mobile/): le dipendenze sono già escluse da "node_modules" qui sopra,
# i file costruiti e local.properties da mobile/android/.gitignore.
# Le chiavi di firma dell'app (keystore) non vanno MAI su GitHub, ovunque siano.
*.jks
*.keystore
